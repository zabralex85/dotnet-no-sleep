<Window x:Class="NoSleep.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoSleep settings" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
	<StackPanel Margin="16">
		<TextBlock Text="Keep awake for" FontWeight="SemiBold" />
		<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
			<TextBox x:Name="Hours" Width="48" />
			<TextBlock Text="h" Margin="4,0,12,0" VerticalAlignment="Center" />
			<TextBox x:Name="Minutes" Width="48" />
			<TextBlock Text="min" Margin="4,0,12,0" VerticalAlignment="Center" />
			<Button Content="Start" Padding="12,2" Click="OnStartTimed" />
		</StackPanel>

		<TextBlock Text="Keep awake until" FontWeight="SemiBold" Margin="0,16,0,0" />
		<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
			<DatePicker x:Name="Date" Width="130" />
			<TextBox x:Name="Time" Width="60" Margin="8,0,12,0" VerticalContentAlignment="Center" ToolTip="HH:mm" />
			<Button Content="Start" Padding="12,2" Click="OnStartExpirable" />
		</StackPanel>

		<TextBlock Text="Tray presets (minutes)" FontWeight="SemiBold" Margin="0,16,0,0" />
		<DataGrid x:Name="Presets" Height="150" Margin="0,6,0,0" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
				<DataGridTextColumn Header="Minutes" Binding="{Binding Minutes}" Width="80" />
			</DataGrid.Columns>
		</DataGrid>
		<TextBlock Text="Select a row and press Delete to remove it." Foreground="Gray" Margin="0,4,0,0" />

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="Save presets" Padding="12,2" Click="OnSavePresets" />
			<Button Content="Close" Padding="12,2" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
		</StackPanel>
	</StackPanel>
</Window>
